FROM nvidia/cuda:12.6.3-cudnn-runtime-ubuntu22.04

# Ubuntu 22.04 ships Python 3.10 by default -- fine, the codebase only needs
# 3.10+ (uses `int | None` union syntax).
# poppler-utils: required by pdf2image to rasterize PDFs.
# libgl1/libglib2.0-0/libsm6/libxext6/libxrender1: required by opencv-python.
# libgomp1: required by onnxruntime.
# fonts-dejavu-core: Vietnamese-capable TTF used to label debug bbox overlays.
# build-essential + python3-dev: torch==2.13.0 silently routes some matmul
# patterns (e.g. RoPE frequency computation -- hit via Surya's TableRecPredictor
# decoder here, but not specific to it) through a Triton-JIT-compiled kernel
# at *runtime* -- even when nothing in this codebase asks for Triton
# directly. Triton's CUDA driver shim compiles a small CPython C-extension
# (cuda_utils.c, `#include <Python.h>`) to talk to the driver, which needs
# BOTH a real C compiler (build-essential) AND the Python dev headers
# (python3-dev, for Python.h -- build-essential alone doesn't provide this)
# available at runtime. Neither is present by default on the base image (a
# "-runtime-" CUDA image, not "-devel-").
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-dev \
    poppler-utils \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender1 \
    libgomp1 \
    fonts-dejavu-core \
    build-essential \
    && rm -rf /var/lib/apt/lists/* \
    && ln -s /usr/bin/python3 /usr/bin/python

WORKDIR /app



COPY requirements-gpu.txt .
# CUDA-enabled torch/torchvision and PaddlePaddle's own GPU build (PaddlePaddle
# isn't on PyPI for GPU -- it has its own CUDA-matched package index), matching
# the base image's CUDA 12.6.
#
# ORDER MATTERS, DO NOT REVERSE -- this mirrors the exact sequence verified
# working manually on vast.ai (see vastai_gpu_deploy_TEST_deepdoc_vietocr_dh_test.txt
# BUOC 6): paddlepaddle-gpu FIRST, then requirements-gpu.txt (which pulls in
# mineru[pipeline]'s own transitive torch as a side effect), THEN torch/
# torchvision pinned LAST so our exact verified pair wins over whatever
# mineru's resolver picked -- pip resolves torch's own required nvidia-*-cu1x
# sub-deps automatically as part of that final step, same as the vast.ai
# manual run (which needed no separate nvidia-*-cu12 pinning pass at all and
# still worked). An earlier version of this Dockerfile installed torch
# BEFORE paddle (the reverse order), which is what made a manual
# nvidia-*-cu12 override pass necessary in the first place -- no longer
# needed now that the order matches the validated recipe.
#
# The final torch/torchvision install only actually reinstalls if mineru's
# own resolver (the requirements-gpu.txt step above) landed on a DIFFERENT
# version than the pin -- avoids redundantly re-downloading/reinstalling
# ~1.5GB of torch + nvidia-*-cu1x wheels when mineru's resolver already
# picked the exact same version (observed in practice: it currently does).
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir paddlepaddle-gpu==3.3.0 -i https://www.paddlepaddle.org.cn/packages/stable/cu126/ \
    && pip install --no-cache-dir -r requirements-gpu.txt \
    && installed_torch="$(pip show torch 2>/dev/null | grep -i '^Version:' | awk '{print $2}')" \
    && installed_tv="$(pip show torchvision 2>/dev/null | grep -i '^Version:' | awk '{print $2}')" \
    && if [ "$installed_torch" = "2.13.0" ] && [ "$installed_tv" = "0.28.0" ]; then \
        echo "torch==$installed_torch / torchvision==$installed_tv already match the pin, skipping reinstall"; \
    else \
        pip install --no-cache-dir --force-reinstall torch==2.13.0 torchvision==0.28.0; \
    fi

# surya-ocr==0.17.1 declares `pillow<11.0.0`, which directly conflicts with
# mineru[pipeline]'s (unconditional, every version) `pillow>=11.0.0` -- no
# overlapping version exists, so it can't go in requirements-gpu.txt's
# normal resolved install. Install it with --no-deps (skip pip re-checking/
# reinstalling its own pillow/torch/transformers pins -- which would also
# risk re-triggering the nvidia-*-cu12 version stomping the pass above just
# fixed) and separately install the rest of ITS OWN direct deps not already
# covered by requirements-gpu.txt -- excluding pillow (keep mineru's
# >=11.0.0), opencv-python-headless (already have opencv-python), torch,
# and transformers (mineru's own pin already satisfies surya's floor). This
# assumes surya's code works fine against Pillow 11 despite its
# conservative upper pin -- only its TableRecPredictor is used in this
# project (basic PIL Image open/convert/resize), so this should be safe,
# but re-verify against real table crops after building.
RUN pip install --no-cache-dir --no-deps surya-ocr==0.17.1 \
    && pip install --no-cache-dir \
        "click<9.0.0,>=8.1.8" \
        "filetype<2.0.0,>=1.2.0" \
        "platformdirs<5.0.0,>=4.3.6" \
        "pydantic<3.0.0,>=2.5.3" \
        "pydantic-settings<3.0.0,>=2.1.0" \
        "pypdfium2==4.30.0" \
        "python-dotenv<2.0.0,>=1.0.0"

# table_cls==1.2.0 (RapidAI wired/wireless table classifier) depends on bare
# `onnxruntime` (CPU build) -- installing it normally would pull that in
# alongside `onnxruntime-gpu` into the same site-packages/onnxruntime/
# directory and can silently break the GPU one (the exact onnxruntime vs
# onnxruntime-gpu incident hit earlier on vast.ai). --no-deps skips that,
# then its other direct deps not already covered above (numpy, opencv-python,
# Shapely, requests) get installed explicitly.
RUN pip install --no-cache-dir --no-deps table_cls==1.2.0 \
    && pip install --no-cache-dir scipy scikit-image tqdm

COPY . .

# Pre-download PP-DocLayout weights -- BEST EFFORT ONLY, not required to
# succeed here. `paddlepaddle-gpu` links `libpaddle.so` directly against the
# real NVIDIA driver's `libcuda.so.1` -- even a plain `import paddle` crashes
# with "ImportError: libcuda.so.1: cannot open shared object file" on any
# machine/container that doesn't have the driver present, REGARDLESS of
# requested device (cpu/gpu). `docker build` never has GPU access (only
# `docker run`/`docker compose up --gpus`/`deploy.reservations.devices` do,
# see docker-compose.gpu.yml) -- so this import is EXPECTED to fail during a
# normal build and can't be fixed by retrying, pinning versions, or anything
# else done at build time. Swallow the failure here and let it download
# lazily on the container's first real request instead, when GPU is actually
# available.
RUN python -c "from paddleocr import LayoutDetection; LayoutDetection(model_name='PP-DocLayout_plus-L')" \
    && echo "PP-DocLayout pre-downloaded OK" \
    || echo "WARNING: skipping PP-DocLayout pre-download at build time (no GPU during docker build) -- will download on first real request instead"

# RapidAI's table_cls QAnything classifier weight -- CPU-only, no paddle/CUDA
# involved, so unlike PP-DocLayout above this CAN and MUST succeed at build
# time. model_type="q" must match module/table/mineru_processor.py. Retries
# a few times -- modelscope.cn downloads (table_cls's own, no retry logic in
# that library) have been observed to drop mid-transfer on some networks
# (IncompleteRead), which is a transient connectivity issue, not a code bug.
RUN success=0; \
    for i in 1 2 3 4 5; do \
        python -c "from table_cls import TableCls; TableCls(model_type='q')" \
        && { success=1; break; }; \
        echo "table_cls pre-download attempt $i failed, retrying..."; \
        sleep 5; \
    done; \
    [ "$success" = "1" ]

EXPOSE 8000

CMD ["uvicorn", "server.main:app", "--host", "0.0.0.0", "--port", "8000"]
